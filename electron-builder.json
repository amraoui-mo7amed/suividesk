{
  "appId": "dz.cnas.suividesk",
  "productName": "SuiviDesk",
  "copyright": "Copyright © 2026 CNAS",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "assets/**/*",
    "python/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "python",
      "to": "python"
    },
    {
      "from": "assets",
      "to": "assets"
    }
  ],
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "icon": "assets/icon.icns"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SuiviDesk"
  }
}
