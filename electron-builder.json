{
  "appId": "dz.cnas.suividesk",
  "productName": "SuiviDesk",
  "copyright": "Copyright © 2026 CNAS",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "assets/**/*",
    "python/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "python",
      "to": "python"
    },
    {
      "from": "assets",
      "to": "assets"
    }
  ],
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "SuiviDesk",
    "artifactName": "SuiviDesk-Setup-${version}.exe"
  },
  "portable": {
    "artifactName": "SuiviDesk-Portable-${version}.exe"
  },
  "mac": {
    "icon": "assets/icon.icns",
    "category": "public.app-category.business",
    "identity": null,
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "artifactName": "SuiviDesk-${version}-${arch}.${ext}"
  },
  "dmg": {
    "artifactName": "SuiviDesk-${version}-${arch}.dmg"
  }
}
